EXCLUDES_COMMON="README.md LICENSE AGENTS.md common linux macos scripts selene.toml stylua.toml vim.yml .styluaignore .git .gitignore"

DARWIN_DOTFILES_DIR="$HOME/projects/dotfiles"
LINUX_DOTFILES_DIR="$HOME/Work/dotfiles"

case "$(uname -s)" in
  Darwin)
    EXCLUDES="$EXCLUDES_COMMON"
    DOTFILES_DIRS="$DARWIN_DOTFILES_DIR/common $DARWIN_DOTFILES_DIR/macos/dotfiles"
    SYMLINK_DIRS="config/nvim config/ghostty config/kitty config/gitui ssh"
    SYMLINK_FILES="codex/config.toml tmux.conf"
    ;;
  Linux)
    EXCLUDES="$EXCLUDES_COMMON"
    DOTFILES_DIRS="$LINUX_DOTFILES_DIR/common $LINUX_DOTFILES_DIR/linux/dotfiles"
    SYMLINK_DIRS="config/nvim"
    SYMLINK_FILES="tmux.conf"
    ;;
  *)
    EXCLUDES="$EXCLUDES_COMMON"
    DOTFILES_DIRS="$DARWIN_DOTFILES_DIR/common $DARWIN_DOTFILES_DIR/macos/dotfiles"
    SYMLINK_DIRS="config/nvim config/ghostty config/kitty config/gitui ssh"
    SYMLINK_FILES="codex/config.toml tmux.conf"
    ;;
esac
