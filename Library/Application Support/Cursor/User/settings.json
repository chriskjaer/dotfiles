{
    "editor.tabSize": 2,
    "editor.formatOnSave": true,
    "editor.inlineSuggest.enabled": true,
    "editor.minimap.enabled": false,
    "editor.rulers": [
        {
            "column": 80,
            "color": "#00000026"
        }
    ],
    "eslint.format.enable": true,
    "eslint.codeActionsOnSave.rules": null,
    "editor.hideCursorInOverviewRuler": true,
    "editor.overviewRulerBorder": false,
    "editor.scrollbar.horizontal": "hidden",
    "editor.scrollbar.vertical": "hidden",
    "eslint.probe": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact",
        "html",
        "vue",
        "markdown",
        "graphql"
    ],
    "eslint.timeBudget.onValidation": {
        "warn": 4000,
        "error": 8000
    },
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact",
        "graphql"
    ],
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "explorer.openEditors.visible": 1,
    "editor.guides.indentation": false,
    "workbench.tips.enabled": false,
    "workbench.editor.showTabs": "single",
    "workbench.editor.showIcons": false,
    "workbench.settings.editor": "json",
    "editor.cursorBlinking": "solid",
    "syntaxTree.additionalPlugins": [
        "plugin/trailing_comma"
    ],
    "syntaxTree.advanced.commandPath": "${userHome}/.asdf/shims/stree",
    "[ruby]": {
        "editor.defaultFormatter": "Shopify.ruby-lsp",
        "editor.formatOnType": true,
        "editor.insertSpaces": true,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        "editor.semanticHighlighting.enabled": true,
        "editor.rulers": [
            120
        ]
    },
    "vim.enableNeovim": true,
    "vim.highlightedyank.enable": true,
    "vim.hlsearch": true,
    "vim.leader": ",",
    "vim.useSystemClipboard": true,
    "vim.insertModeKeyBindings": [
        {
            "before": [
                "j",
                "j"
            ],
            "after": [
                "<Esc>"
            ]
        }
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "g",
                "f"
            ],
            "after": [
                "g",
                "d"
            ]
        },
        {
            "before": [
                "leader",
                "g",
                "f"
            ],
            "after": "editor.action.goToDeclaration"
        },
        {
            "before": [
                "leader",
                "w"
            ],
            "commands": [
                "workbench.action.files.save"
            ]
        },
        {
            "before": [
                "<leader>",
                "<leader>"
            ],
            "commands": [
                {
                    "command": "workbench.action.openPreviousEditorFromHistory"
                },
                {
                    "command": "workbench.action.acceptSelectedQuickOpenItem"
                }
            ]
        },
        {
            "before": [
                "-"
            ],
            "commands": [
                "vsnetrw.open"
            ],
            "when": "editorLangId != vsnetrw"
        },
        {
            "before": [
                "<C-p>"
            ],
            "commands": [
                {
                    "command": "workbench.action.quickOpen"
                }
            ]
        },
        {
            "before": [
                "K"
            ],
            "commands": [
                {
                    "command": "editor.action.showHover"
                }
            ]
        },
        {
            "before": [
                "leader",
                "r",
                "n"
            ],
            "commands": [
                {
                    "command": "editor.action.rename"
                }
            ]
        },
        {
            "before": [
                "leader",
                "c",
                "a"
            ],
            "commands": [
                {
                    "command": "editor.action.quickFix"
                }
            ]
        },
        {
            "before": [
                "leader",
                "f",
                "e"
            ],
            "commands": [
                {
                    "command": "workbench.files.action.showActiveFileInExplorer"
                }
            ]
        },
        {
            "before": [
                "[",
                "d"
            ],
            "commands": [
                {
                    "command": "editor.action.marker.next"
                }
            ]
        },
        {
            "before": [
                "leader",
                "c",
                "l"
            ],
            "after": [
                "y",
                "i",
                "w",
                "o"
            ],
            "commands": [
                {
                    "command": "editor.action.insertSnippet",
                    "when": "editorTextFocus",
                    "args": {
                        "snippet": "console.log('$1', $1)$0"
                    }
                },
                {
                    "command": "editor.action.clipboardPasteAction",
                    "when": "editorTextFocus"
                },
                {
                    "command": "extension.vim_escape",
                    "when": "editorTextFocus"
                }
            ]
        },
        {
            "before": [
                "<C-w>",
                "q"
            ],
            "commands": [
                "workbench.action.closeEditorsInGroup"
            ]
        },
        {
            "before": [
                "leader",
                "c",
                "o"
            ],
            "commands": [
                "aichat.show-ai-chat",
            ]
        },
    ],
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[javascript]": {
        "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "git.autofetch": true,
    "githubPullRequests.pullBranch": "never",
    "telemetry.telemetryLevel": "off",
    "[markdown]": {
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
    },
    "[shellscript]": {
        "editor.defaultFormatter": "foxundermoon.shell-format"
    },
    "[dotenv]": {
        "editor.defaultFormatter": "foxundermoon.shell-format"
    },
    "github.copilot.enable": {
        "*": true,
        "plaintext": true,
        "markdown": true,
        "scminput": false,
        "ruby": true
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "git.openRepositoryInParentFolders": "never",
    "workbench.activityBar.location": "hidden",
    "window.commandCenter": false,
    "[python]": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
        },
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "python.analysis.typeCheckingMode": "strict",
    "python.analysis.autoImportCompletions": true,
    "notebook.lineNumbers": "on",
    "notebook.output.scrolling": false,
    "notebook.formatOnSave.enabled": true,
    "notebook.codeActionsOnSave": {
        "notebook.source.fixAll": "explicit",
        "notebook.source.organizeImports": "explicit"
    },
    "files.associations": {
        "*.ndjson": "jsonl",
        "*.sql": "jinja-sql",
        "*.yaml": "jinja-yaml"
    },
    "rubyLsp.rubyVersionManager": {
        "identifier": "asdf"
    },
    "editor.stickyScroll.enabled": false,
    "[dockerfile]": {
        "editor.defaultFormatter": "foxundermoon.shell-format"
    },
    "typescript.tsdk": "./node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "terminal.external.osxExec": "Ghostty.app",
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer"
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "cursor.cpp.disabledLanguages": [
        "scminput"
    ],
    "[ignore]": {
        "editor.defaultFormatter": "foxundermoon.shell-format"
    },
    "cursor.chat.smoothStreaming": true,
    "terminal.integrated.persistentSessions.enabled": true,
    "terminal.integrated.persistentSessions.prefix": "${workspaceFolderBasename}-",
    "terminal.integrated.persistentSessionReviveProcess": "onExitAndWindowClose",
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "rubyLsp.featureFlags": {
        "all": true
    },
    "explorer.confirmDelete": false,
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.profiles.osx": {
        "zsh": {
            "path": "zsh",
            "args": [
                "-l"
            ]
        }
    },
    "update.releaseTrack": "prerelease",
    "altimate.onboardedMcpServer": true,
    "cursor.composer.shouldAllowCustomModes": true
}