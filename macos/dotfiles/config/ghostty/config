# Default theme (matches Neovim + tmux)
theme = "TokyoNight Storm"

# Hide the titlebar entirely.
macos-titlebar-style = "hidden"

# Shift+Enter -> Meta+Enter (ESC+CR) for tmux remap to Ctrl+J.
keybind = shift+enter=text:\x1b\r

# Prefer Omarchy theme on Linux if present.
config-file = ?../omarchy/current/theme/ghostty.conf
